# ============================================================
#  cloudflared — Cloudflare Tunnel stack environment variables
#  Docs: https://developers.cloudflare.com/tunnel/reference/run-parameters/
#
#  HOW TO USE IN PORTAINER
#  Load this file in the stack's "Environment variables" section,
#  OR copy/paste individual values directly into the Portainer UI.
#  DO NOT commit a populated TUNNEL_TOKEN to source control.
# ============================================================


# ── Required ─────────────────────────────────────────────────────────────────

# Tunnel token from Cloudflare Zero Trust > Networking > Tunnels.
# Dashboard: select your tunnel > Add a replica > copy the eyJ... token string.
# API:       GET /accounts/{account_id}/cfd_tunnel/{tunnel_id}/token
# Rotate tokens regularly; each replica can share the same token or use its own.
TUNNEL_TOKEN=

# Alternative: store the token in a file and reference it here (requires cloudflared >= 2025.4.0).
# Mount the file into the container and set this instead of TUNNEL_TOKEN.
# Example: TUNNEL_TOKEN_FILE=/run/secrets/tunnel_token
# TUNNEL_TOKEN_FILE=


# ── Image ────────────────────────────────────────────────────────────────────

# Pin to a specific version tag for reproducible deployments.
# Default: latest
# Example: 2025.7.0
CLOUDFLARED_IMAGE_TAG=latest


# ── Logging ──────────────────────────────────────────────────────────────────

# Log verbosity: debug | info | warn | error | fatal
# debug exposes request URLs and headers — avoid in production.
# Default: info
TUNNEL_LOGLEVEL=info

# Console log format: default | json
# Use json for log aggregation systems (Loki, Datadog, Grafana Alloy, etc.).
# Requires cloudflared >= 2025.6.1
# Default: default
TUNNEL_LOG_OUTPUT=default


# ── Connection ───────────────────────────────────────────────────────────────

# Transport protocol: auto | quic | http2
# auto → tries quic first, falls back to http2 if UDP port 7844 is blocked.
# Default: auto
TUNNEL_TRANSPORT_PROTOCOL=auto

# IP version for the cloudflared → Cloudflare edge connection: auto | 4 | 6
# auto → lets the OS pick based on DNS resolution.
# Default: 4
TUNNEL_EDGE_IP_VERSION=4

# Grace period on SIGINT/SIGTERM before forcefully closing active connections.
# Default: 30s
TUNNEL_GRACE_PERIOD=30s

# Max retries on connection/protocol errors (exponential backoff: 1,2,4,8,16s).
# Not recommended to increase significantly.
# Default: 5
TUNNEL_RETRIES=5

# Prometheus metrics endpoint (host:port inside the container).
# The compose file maps this to 127.0.0.1 on the host.
# cloudflared picks the first available port in the range 20241-20245 when left
# at the default, but setting it explicitly avoids conflicts with other replicas.
# Default: 0.0.0.0:20241  (inside the container)
TUNNEL_METRICS=0.0.0.0:20241


# ── Network (optional) ────────────────────────────────────────────────────────

# Docker network name shared with origin containers.
# Other stacks join this network so cloudflared can reach them by service name.
# Default: cloudflared
CLOUDFLARED_NETWORK_NAME=cloudflared


# ── Advanced / Uncomment to enable ───────────────────────────────────────────

# Route all connections through US data centers only (or "us" for FedRAMP High).
# FedRAMP High tunnels do NOT need this — the token determines routing automatically.
# Leave empty for the global region.
# TUNNEL_REGION=

# Force post-quantum key agreements on quic connections (no non-PQ fallback).
# Only valid with TUNNEL_TRANSPORT_PROTOCOL=quic.
# TUNNEL_POST_QUANTUM=

# Force a specific outgoing IP for the cloudflared → Cloudflare edge connection.
# Useful when the host has multiple network interfaces.
# Example: TUNNEL_EDGE_BIND_ADDRESS=192.168.1.10
# TUNNEL_EDGE_BIND_ADDRESS=

# Custom tag to identify this connector in the Cloudflare dashboard.
# Format: KEY=VALUE  (single tag only via env var; use --tag flags for multiple)
# Example: TUNNEL_TAG=env=prod
# TUNNEL_TAG=

# Write a PID file inside the container (useful for health scripts).
# Example: TUNNEL_PIDFILE=/tmp/cloudflared.pid
# TUNNEL_PIDFILE=
