# ============================================================
#  Portainer EE — stack environment variables
#  Docs: https://docs.portainer.io/advanced/cli
#
#  HOW TO USE IN PORTAINER
#  Load this file in the stack's "Environment variables" section,
#  OR copy/paste individual values directly into the Portainer UI.
#  DO NOT commit a populated PORTAINER_LICENSE_KEY to source control.
# ============================================================


# ── Required ─────────────────────────────────────────────────────────────────

# Portainer Business Edition license key.
# Obtain from https://www.portainer.io/take-3 or your account portal.
PORTAINER_LICENSE_KEY=


# ── Image ────────────────────────────────────────────────────────────────────

# Pin to a specific version for reproducible deployments.
# Default: latest
# Example: 2.21.5
PORTAINER_IMAGE_TAG=latest


# ── Ports ────────────────────────────────────────────────────────────────────

# IP address the Web UI port binds to on the host.
# Use 127.0.0.1 when a reverse proxy (nginx, Traefik) handles TLS termination.
# Use 0.0.0.0 to expose directly on all interfaces.
# Default: 127.0.0.1
PORTAINER_BIND_ADDR=127.0.0.1

# Host port mapped to the Portainer Web UI.
# Default: 9000
PORTAINER_HOST_HTTP_PORT=9000

# Container-internal HTTP port for the Web UI.
# Default: 9000
PORTAINER_HTTP_PORT=9000

# IP address the Edge Agent tunnel port binds to on the host.
# Must be reachable by remote edge agents — set to 0.0.0.0 unless
# all agents run on the same host or behind the same network.
# Default: 0.0.0.0
PORTAINER_TUNNEL_BIND_ADDR=0.0.0.0

# Host port mapped to the Edge Agent tunnel.
# Default: 8000
PORTAINER_HOST_TUNNEL_PORT=8000

# Container-internal tunnel port.
# Default: 8000
PORTAINER_TUNNEL_PORT=8000


# ── Resource Limits ───────────────────────────────────────────────────────────

# Maximum memory available to the container.
# Default: 256m
MEMORY_LIMIT=256m

# Maximum CPU share (fractional cores).
# Default: 0.5
CPU_LIMIT=0.5


# ── Network ───────────────────────────────────────────────────────────────────

# Docker network name created for this stack.
# Default: portainer
PORTAINER_NETWORK_NAME=portainer
