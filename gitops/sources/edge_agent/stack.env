# ============================================================
#  Portainer Edge Agent — stack environment variables
#  Docs: https://docs.portainer.io/admin/environments/add/edge
#
#  HOW TO USE IN PORTAINER
#  Load this file in the stack's "Environment variables" section,
#  OR copy/paste individual values directly into the Portainer UI.
#  DO NOT commit a populated EDGE_KEY to source control.
# ============================================================


# ── Required ─────────────────────────────────────────────────────────────────

# Edge key generated by Portainer when you add an Edge environment.
# Portainer UI: Settings > Environments > Add environment
#               > Docker Standalone > Edge Agent > copy the EDGE_KEY value
EDGE_KEY=


# ── Image ────────────────────────────────────────────────────────────────────

# Pin to a specific version for reproducible deployments.
# Default: latest
# Example: 2.21.5
EDGE_AGENT_IMAGE_TAG=latest


# ── Connection ────────────────────────────────────────────────────────────────

# How long the agent waits without activity before closing the tunnel.
# Increase for environments with high-latency links.
# Default: 5m
EDGE_INACTIVITY_TIMEOUT=5m

# How often (seconds) the agent polls the Portainer server when idle.
# Lower = more responsive; higher = less traffic.
# Default: 5
EDGE_POLL_FREQUENCY=5

# Agent port for local API calls from the container engine.
# Only change this if port 9001 is already in use on the host.
# Default: 9001
AGENT_PORT=9001


# ── TLS ───────────────────────────────────────────────────────────────────────

# Skip TLS certificate verification when polling the Portainer server.
# Set to 1 ONLY in dev/lab environments where the server uses a self-signed cert.
# Default: 0  (verification enabled — recommended for production)
EDGE_INSECURE_POLL=0


# ── Logging ───────────────────────────────────────────────────────────────────

# Log verbosity: DEBUG | INFO | WARN | ERROR
# Default: INFO
LOG_LEVEL=INFO


# ── Network ───────────────────────────────────────────────────────────────────

# Docker network name created for this stack.
# Default: portainer_edge_agent
EDGE_AGENT_NETWORK_NAME=portainer_edge_agent


# ── Advanced / Uncomment to enable ───────────────────────────────────────────

# Cluster node address — only needed when multiple agents run on the same host
# or when using Portainer's agent cluster mode.
# Example: AGENT_CLUSTER_ADDR=192.168.1.100
# AGENT_CLUSTER_ADDR=
