# CertMate runtime configuration for the Portainer GitOps stack.
# https://www.certmate.org/docs/getting-started.html
# https://www.certmate.org/docs/docker-deployment.html
#
# This file contains non-secret settings and can be tracked in Git.
# Add API_BEARER_TOKEN, CLOUDFLARE_TOKEN, and any backup passphrase through
# Portainer's stack environment variables. Do not commit populated credentials.

# Reverse proxy settings. Keep BEHIND_PROXY=false unless a trusted proxy is
# configured. When TLS terminates at that proxy, change the scheme to https.
BEHIND_PROXY=false
PREFERRED_URL_SCHEME=http

# CertMate defaults; listed here to make the deployment settings explicit.
GUNICORN_TIMEOUT=300
SESSION_TIMEOUT_HOURS=8
CERTMATE_LOG_LEVEL=INFO
CERTMATE_LOG_JSON=true

# Also write rotated application logs to the persistent logs volume so the
# CertMate UI can stream them. Set this to an empty value to use stdout only.
CERTMATE_LOG_FILE=/app/logs/certmate.log

# Optional overrides to add in Portainer's stack environment variables:
# API_BEARER_TOKEN       Protect first-run setup and authenticate API requests.
# CLOUDFLARE_TOKEN       Seed the default Cloudflare DNS account.
# LETSENCRYPT_EMAIL      Override the ACME email configured in the UI.
# CERTMATE_BACKUP_PASSPHRASE  Encrypt automatic backups for full restore.
#
# The published port and image version are set in docker-compose.yml because
# stack.env values are container runtime variables, not Compose substitutions.
# Default UI: http://localhost:8000
