# =============================================================================
# CertMate - Environment Variables
# https://www.certmate.org/docs/docker-deployment.html
#
# Rename this file to stack.env (or reference as env_file in Portainer stack).
# All variables are optional unless noted. Defaults are shown.
# =============================================================================

# -----------------------------------------------------------------------------
# IMAGE / VERSION
# Pin a version tag in production to prevent unintentional upgrades.
# Example: 2.35 | 2 | latest
# -----------------------------------------------------------------------------
CERTMATE_VERSION=latest

# -----------------------------------------------------------------------------
# SECURITY - REQUIRED before the instance is reachable from any network
# -----------------------------------------------------------------------------

# API authentication token used to protect all API endpoints.
# Auto-generated at startup if left unset, but set it explicitly so you know
# the value. On first run you paste this token into the setup screen to create
# the admin account. If this value differs from the stored token, the stored
# one is replaced at startup.
API_BEARER_TOKEN=change-me-use-a-long-random-string

# Flask session signing key.
# If unset (or set to a placeholder like "change-me"), CertMate auto-generates
# one and saves it to /app/data/.secret_key so sessions survive restarts.
# Set it explicitly to control key rotation.
SECRET_KEY=change-me-use-a-long-random-string

# Passphrase for encrypted automatic backups.
# With it set: backups are complete and encrypted (PBKDF2-SHA256 + Fernet).
# Without it:  credentials are masked in backups; restore is refused on
#              instances that already hold certificates.
CERTMATE_BACKUP_PASSPHRASE=change-me-use-a-strong-passphrase

# -----------------------------------------------------------------------------
# ACME / LET'S ENCRYPT
# -----------------------------------------------------------------------------

# Email address registered with the ACME CA (Let's Encrypt).
# Overrides any email saved in the web UI.
LETSENCRYPT_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# DNS PROVIDERS
# Only CLOUDFLARE_TOKEN is read from the environment. All other DNS providers
# (Route 53, Azure, Google Cloud DNS, PowerDNS, etc.) must be configured via
# the web UI (Settings > DNS Providers) or the API.
# Note: CLOUDFLARE_API_TOKEN is ignored — the correct variable is CLOUDFLARE_TOKEN.
# -----------------------------------------------------------------------------
CLOUDFLARE_TOKEN=your-cloudflare-api-token-here

# -----------------------------------------------------------------------------
# NETWORKING
# -----------------------------------------------------------------------------

# Port CertMate listens on inside the container. Default: 8000
# If you change this, also update CERTMATE_HOST_PORT below.
PORT=8000

# Host interface and port for the published port mapping.
# 127.0.0.1 = loopback only (recommended; put a reverse proxy in front).
# 0.0.0.0   = all interfaces (only if no reverse proxy).
CERTMATE_PORT_BIND=127.0.0.1
CERTMATE_HOST_PORT=8000

# Set to true when a reverse proxy (e.g. nginx, Traefik) sits in front.
# Enables trust of X-Forwarded-* headers from one proxy hop so rate limiting
# and audit entries see the real client IP.
# WARNING: leave unset/false when there is no proxy — a client can otherwise
#          forge its own IP, which undermines login rate limiting.
BEHIND_PROXY=false

# When TLS terminates at the proxy, mark the session cookie Secure.
# Values: http | https
PREFERRED_URL_SCHEME=https

# -----------------------------------------------------------------------------
# GUNICORN / PERFORMANCE
# -----------------------------------------------------------------------------

# Worker timeout in seconds. Default: 300
# DNS-01 challenges on slow DNS providers can take up to 5 minutes.
GUNICORN_TIMEOUT=300

# -----------------------------------------------------------------------------
# SESSIONS
# -----------------------------------------------------------------------------

# Login session lifetime in hours. Default: 8
SESSION_TIMEOUT_HOURS=8

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Log verbosity. Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
CERTMATE_LOG_LEVEL=INFO

# Emit logs as JSON (true) or plain text (false). Default: true
CERTMATE_LOG_JSON=true

# Write a rotated log file inside the container in addition to stdout.
# Requires the /app/logs volume to be mounted.
# Leave empty to log to stdout only.
CERTMATE_LOG_FILE=/app/logs/certmate.log

# -----------------------------------------------------------------------------
# STORAGE / PATHS
# -----------------------------------------------------------------------------

# Override the directory where issued certificates are stored.
# Default: /app/certificates
# If changed, also mount the new path as a volume.
# CERTMATE_CERT_DIR=/app/certificates

# -----------------------------------------------------------------------------
# RESOURCE LIMITS (Docker deploy constraints)
# -----------------------------------------------------------------------------
MEMORY_LIMIT=512m
CPU_LIMIT=1.0

# -----------------------------------------------------------------------------
# ADVANCED / SCHEMA
# -----------------------------------------------------------------------------

# Allow loading settings.json written by a newer CertMate version.
# Set to 1 only when intentionally downgrading; fields from the newer version
# will be silently dropped.
# CERTMATE_ALLOW_SCHEMA_DOWNGRADE=0
