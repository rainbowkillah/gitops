# ============================================================
#  cloudflared — Cloudflare Tunnel stack environment variables
#  Docs: https://developers.cloudflare.com/tunnel/reference/run-parameters/
#
#  HOW TO USE IN PORTAINER
#  Load this file in the stack's "Environment variables" section,
#  OR copy/paste individual values directly into the Portainer UI.
#  DO NOT commit a populated TUNNEL_TOKEN to source control.
# ============================================================


# ── Required ─────────────────────────────────────────────────────────────────

# Tunnel token from Cloudflare Zero Trust > Networks > Tunnels > your tunnel
# Copy the token shown when you create or view a remotely-managed tunnel.
TUNNEL_TOKEN=


# ── Image ────────────────────────────────────────────────────────────────────

# Pin to a specific version tag for reproducible deployments.
# Default: latest
# Example: 2025.7.0
CLOUDFLARED_IMAGE_TAG=latest


# ── Logging ──────────────────────────────────────────────────────────────────

# Log verbosity: debug | info | warn | error | fatal
# Default: info
# Note: debug exposes request headers — avoid in production.
TUNNEL_LOGLEVEL=info

# Console log format: default | json
# Use json for log aggregation systems (Loki, Datadog, etc.)
# Requires cloudflared >= 2025.6.1
# Default: default
TUNNEL_LOG_OUTPUT=default


# ── Connection ───────────────────────────────────────────────────────────────

# Transport protocol: auto | quic | http2
# auto → tries quic first, falls back to http2 if UDP is blocked.
# Default: auto
TUNNEL_TRANSPORT_PROTOCOL=auto

# IP version for the cloudflared → Cloudflare edge connection: auto | 4 | 6
# Default: auto
TUNNEL_EDGE_IP_VERSION=auto

# Grace period on SIGINT/SIGTERM before forcefully closing connections.
# Default: 30s
TUNNEL_GRACE_PERIOD=30s

# Max retries on connection/protocol errors (exponential backoff: 1,2,4,8,16s)
# Default: 5
TUNNEL_RETRIES=5

# Prometheus metrics endpoint (host:port or ip:port).
# The compose file maps this to 127.0.0.1 on the host by default.
# Default: 0.0.0.0:20241  (inside the container)
TUNNEL_METRICS=0.0.0.0:20241


# ── Network (optional) ────────────────────────────────────────────────────────

# Docker network name shared with origin containers.
# Other stacks join this network so cloudflared can reach them by service name.
# Default: cloudflared
CLOUDFLARED_NETWORK_NAME=cloudflared


# ── Advanced / Uncomment to enable ───────────────────────────────────────────

# Route connections through US data centers only.
# Leave empty for the global region. Set to "us" for US-only or FedRAMP.
# TUNNEL_REGION=

# Force post-quantum key agreements only (no non-PQ fallback).
# Only valid with protocol=quic. Set to "true" to enable.
# TUNNEL_POST_QUANTUM=

# Force cloudflared to use a specific outgoing IP to reach the Cloudflare edge.
# Useful when the host has multiple network interfaces.
# Example: TUNNEL_EDGE_BIND_ADDRESS=192.168.1.10
# TUNNEL_EDGE_BIND_ADDRESS=

# Custom DNS resolver addresses (ip:port). Requires cloudflared >= 2025.7.0.
# Separate multiple addresses with a space (configured as repeated flags in compose).
# Example: TUNNEL_DNS_RESOLVER_ADDRS=1.1.1.1:53
# TUNNEL_DNS_RESOLVER_ADDRS=

# Custom tag to identify this connector in the Cloudflare dashboard.
# Format: KEY=VALUE  (single tag only via env var; use command flags for multiple)
# Example: TUNNEL_TAG=env=prod
# TUNNEL_TAG=

# Path to write the PID file inside the container (useful for health scripts).
# Example: TUNNEL_PIDFILE=/tmp/cloudflared.pid
# TUNNEL_PIDFILE=
