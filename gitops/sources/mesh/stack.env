# ============================================================
#  Cloudflare Mesh Node — stack environment variables
#  Docs: https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-mesh/guides/run-mesh-in-containers/
#
#  HOW TO USE IN PORTAINER
#  Load this file in the stack's "Environment variables" section,
#  OR copy/paste individual values directly into the Portainer UI.
#  DO NOT commit a populated MESH_NODE_TOKEN to source control.
# ============================================================


# ── Required ─────────────────────────────────────────────────────────────────

# Node token from the Cloudflare dashboard: Networking > Mesh > Add node > Create node.
# Each node must have its own unique token. Using the same token across multiple
# containers preserves a shared identity (HA replicas); different identities need
# different tokens.
MESH_NODE_TOKEN=


# ── Image ────────────────────────────────────────────────────────────────────

# The latest tag is a multi-platform manifest — Docker picks the right arch automatically.
# Pin to a specific arch tag for reproducible deployments or to force an architecture.
#
#   Multi-arch : latest       (default — recommended)
#   x86-64     : latest-amd64
#   ARM64      : latest-arm64
#
# Default: latest
MESH_IMAGE_TAG=latest


# ── Source NAT ────────────────────────────────────────────────────────────────

# Controls source NAT (masquerading).
# When true, the node translates the Mesh CGNAT source address (100.96.x.x) to its
# own local interface IP so return traffic routes correctly without any VPC/router
# changes.
# Set to false only if your network already has static return routes to 100.96.0.0/12.
# Accepts: true | false | 1 | 0
# Default: true
SRCNAT_ENABLED=true
