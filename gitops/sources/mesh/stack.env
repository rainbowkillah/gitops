# ============================================================
#  cloudflared — Cloudflare Mesh stack environment variables
#  Docs: https://developers.cloudflare.com/mesh/guides/run-mesh-in-containers/
#
#  HOW TO USE IN PORTAINER
#  Load this file in the stack's "Environment variables" section,
#  OR copy/paste individual values directly into the Portainer UI.
#  DO NOT commit a populated MESH_NODE_TOKEN to source control.
# ============================================================


# ── Required ─────────────────────────────────────────────────────────────────

# Mesh node  token from Cloudflare Zero Trust > Networks > Mesh >
# Copy the token shown when you create or view a remotely-managed tunnel.
MESH_NODE_TOKEN="<YOUR-TOKEN>"